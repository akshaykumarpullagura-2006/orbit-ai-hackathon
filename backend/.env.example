# Orbit AI Backend Environment Configuration

# Gemini API Key (Get yours at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Frontend fallback API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database & Storage
DATABASE_URL=sqlite:///./orbit_ai.db
STORAGE_DIR=./storage/missions
